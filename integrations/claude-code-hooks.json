{
  "_comment": "合并进 ~/.claude/settings.json 的 hooks 字段（示例，路径按实际安装位置调整）。每个 hook 都调用 claude-light，由脚本根据 stdin JSON 中的 hook_event_name 自行判定灯效。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "~/.local/bin/claude-light", "timeout": 5}
        ]
      }
    ]
  }
}
